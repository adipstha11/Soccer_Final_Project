# No credentials are required: every source used by this pipeline is public.
# Copy to .env only if you want to change defaults.

# Inclusive data cut-off (matches completed on/before this date)
CUTOFF_DATE=2026-11-22
# Seconds between HTTP requests (politeness / rate limiting)
REQUEST_DELAY=0.35
# User-Agent sent with requests (keep it generic)
HTTP_USER_AGENT=football-tactical-research/1.0 (university coursework)

# Optional keys for sources that were evaluated but NOT used (see source_audit.csv)
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_TOKEN=
SPORTMONKS_TOKEN=
